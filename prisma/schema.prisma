// prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum RolUsuario {
  SUPERADMIN          // Nosotros (SaaS)
  ADMIN_GENERAL       // Dueño de la Funeraria (ve todas las sucursales)
  ADMIN_SUCURSAL      // Administrador exclusivo de una sucursal en particular
}

enum EstadoDifunto {
  ACTIVO
  CONSOLIDADO
  ARCHIVADO
  ELIMINADO
}

enum EstadoCondolencia {
  PENDIENTE
  APROBADO
  RECHAZADO
  ELIMINADO
}

enum TiempoRotacion {
  CINCO_SEG     @map("5s")
  DIEZ_SEG      @map("10s")
  QUINCE_SEG    @map("15s")
}

model Sucursal {
  id           String     @id @default(uuid())
  nombre       String     // Ej. "Sucursal Maipú", "Casa Central Los Ángeles"
  direccion    String?
  comuna       String?    // Ej. "Maipú"
  
  funerariaId  String
  funeraria    Funeraria  @relation(fields: [funerariaId], references: [id], onDelete: Cascade)

  // Relaciones de la sucursal
  usuarios     Usuario[]  // Operadores u administradores asignados a esta sucursal
  difuntos     Difunto[]  // Difuntos velados en esta sucursal específica

  creadoEn          DateTime   @default(now())
  actualizadoEn     DateTime   @updatedAt
}

model Funeraria {
  id                    String        @id @default(uuid())
  nombre                String
  slug                  String        @unique
  tiempoRotacionTv      Int      @default(8)       // Segundos por mensaje en pantalla TV
  mensajeInstitucional  String?                    // Texto personalizado para el QR
  requiereModeracion    Boolean  @default(true)    // Moderación activa por defecto en nuevos servicios
  logoUrl               String?
  colorPrimario         String        @default("#111827")
  activo                Boolean       @default(true)
  creadoEn              DateTime      @default(now())
  actualizadoEn         DateTime      @updatedAt
  plan                  String          @default("ESTANDAR") // BASIC, ESTANDAR, ENTERPRISE
  limiteServiciosMes    Int             @default(50)         // Control de volumen mensual

  usuarios              Usuario[]
  sucursales            Sucursal[]
  pagos                 PagoFuneraria[]
  @@map("funerarias")
}

model PagoFuneraria {
  id            String   @id @default(cuid())
  funerariaId   String
  monto         Float
  metodo        String   // Ej: "Transferencia", "Tarjeta", "Efectivo"
  referencia    String?  // Nro de comprobante o transacción
  estado        String   @default("completado") // completado, pendiente
  observacion   String?
  creadoEn      DateTime @default(now())

  funeraria     Funeraria @relation(fields: [funerariaId], references: [id], onDelete: Cascade)
}

model Usuario {
  id                      String        @id @default(uuid())    
  email                   String        @unique
  passwordHash            String
  nombre                  String
  rol                     RolUsuario    @default(ADMIN_FUNERARIA)
  activo                  Boolean       @default(true)
  creadoEn                DateTime      @default(now())
  actualizadoEn           DateTime      @updatedAt
  debeCambiarPassword     Boolean       @default(false)
  tokenRecuperacion       String?       @unique
  expiraTokenRecuperacion DateTime?

  funerariaId        String
  funeraria          Funeraria    @relation(fields: [funerariaId], references: [id], onDelete: Cascade)
  // NUEVO: Opcional si es ADMIN_GENERAL (null), obligatorio si es ADMIN_SUCURSAL
  sucursalId         String?
  sucursal           Sucursal?    @relation(fields: [sucursalId], references: [id], onDelete: SetNull)


  @@index([funerariaId])
  @@map("usuarios")
}

model Difunto {
  id                 String         @id @default(uuid())
  funerariaId        String
  nombre             String
  apellido           String
  fechaNacimiento    DateTime?
  fechaFallecimiento DateTime
  biografia          String?        @db.Text
  fotoPerfilUrl      String?
  estado             EstadoDifunto  @default(ACTIVO)
  pdfAlbumUrl        String?        
  requiereModeracion Boolean        @default(true) // <--- NUEVO: Control por servicio individual
  creadoEn           DateTime       @default(now())
  updatedAt          DateTime       @updatedAt @default(now())

  sucursalId         String
  sucursal           Sucursal     @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  condolencias       Condolencia[]
  configPantalla     ConfiguracionPantalla?

  @@index([funerariaId])
  @@index([estado])
  @@map("difuntos")
}

model Condolencia {
  id            String            @id @default(uuid())
  funerariaId   String            
  difuntoId     String
  nombreAutor   String
  parentesco    String?           
  mensaje       String            @db.Text
  fotoUrl       String?           
  fotoKeyR2     String?           
  estado        EstadoCondolencia @default(APROBADO)
  ipOrigen      String?
  pais          String?           
  creadoEn      DateTime          @default(now())

  difunto       Difunto           @relation(fields: [difuntoId], references: [id], onDelete: Cascade)

  @@index([difuntoId, estado])
  @@index([funerariaId])
  @@map("condolencias")
}

model ConfiguracionPantalla {
  id              String         @id @default(uuid())
  difuntoId       String         @unique
  tiempoRotacion  TiempoRotacion @default(DIEZ_SEG)
  mostrarFotos    Boolean        @default(true)
  mensajeBienvenida String?      @default("En memoria de nuestro ser querido")
  actualizadoEn   DateTime       @updatedAt

  difunto         Difunto        @relation(fields: [difuntoId], references: [id], onDelete: Cascade)

  @@map("configuraciones_pantalla")
}